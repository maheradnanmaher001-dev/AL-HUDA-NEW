# Copy this file's contents into Render/Railway's Environment Variables section.
# Never commit a real .env file with actual secrets to GitHub.

# A random secret used to sign login session tokens. Any long random string works.
JWT_SECRET=change-this-to-a-long-random-string

# From https://app.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=your-brevo-api-key-here

# The email address you verified as a sender in Brevo (Senders, Domains & Dedicated IPs).
# It does not need to be a custom domain — any email you can verify works.
SENDER_EMAIL=your-verified-email@example.com

# Display name shown to users as the sender, e.g. "AL-HUDA"
SENDER_NAME=AL-HUDA

# For Vercel deployment, use your Neon Postgres connection string (see
# backend/README.md Step 2), e.g.:
# postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
# For local testing or Render, the free SQLite default below is fine.
DATABASE_URL=sqlite:///./alhuda.db
